# The project folder is one git repository: research notes, build code and these scripts.
# build/.gitignore covers what the build agent generates.

# Documents added for research: usually copyrighted, and soon too big to keep in git.
/research/sources/*
!/research/sources/.gitkeep

# Data files for the build agent: often big, sometimes under licences that don't allow sharing them,
# and downloadable again with ./fetch-data from the record in fetched.tsv, which is kept, as is
# research's list. Their text copies are made again by convert-docs.
/research/data/*
!/research/data/wanted.txt
!/research/data/fetched.tsv
/research/data-copies/*
!/research/data-copies/.gitkeep

# Claude Code's personal settings, if any get created.
/research/.claude/settings.local.json

# research-gate's state: a failed or unfinished automatic check, and the lock that stops two
# research sessions running the checks at once.
/.research-check-failed
/.research-check.lock

# convert-docs: notes exported as documents, and its lock and working folders.
/exports/
/.convert-docs.*

# fetch-data's lock and working folders.
/.fetch-data.*
